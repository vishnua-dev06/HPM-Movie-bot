# ==========================================
# Malayalam Movie Bot - Environment Template
# ==========================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Administrator Numeric Telegram User IDs (Required)
# Support comma- or space-separated list of multiple trusted administrators:
ADMIN_IDS=123456789,987654321,555555555
# Legacy single admin fallback (optional):
ADMIN_ID=123456789

# MongoDB Atlas Connection URI (Required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (Optional, defaults to malayalam_movie_bot)
DATABASE_NAME=malayalam_movie_bot

# Fixed Sub 1 (Main Movie Channel) Configuration (Required)
# Numeric Channel ID (must begin with -100 for supergroups/channels)
SUB1_CHANNEL_ID=-1001234567890

# Public or Permanent Invite Link for Main Movie Channel (Required)
SUB1_INVITE_URL=https://t.me/your_main_channel

# User Log Channel ID (Optional, must begin with -100 for private channels/supergroups)
# When set, brand-new user registrations will be posted here automatically
LOG_CHANNEL_ID=-1001987654321

# Enable detailed user activity logs in log channel (false by default to prevent noise)
LOG_USER_ACTIVITIES=false

# Advanced High-Performance Broadcast Engine Settings
# Scalable to 100,000–300,000 registered users
BROADCAST_CONCURRENCY=5
BROADCAST_BATCH_SIZE=500
BROADCAST_DELAY_SECONDS=0.05

# Optional Port (Injected automatically by Railway / Cloud platforms)
# PORT=8080

# Note: Sub 2 and dynamic Admins are managed from the Admin Panel and stored in MongoDB.
